# Voyage Backend — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores.

# Conexão com o banco SQLite (Prisma)
DATABASE_URL="file:./dev.db"

# Chave secreta para assinatura de tokens JWT.
# OBRIGATÓRIO — o servidor não inicia sem esta variável.
# Use um valor forte e aleatório (mínimo 32 caracteres).
# Exemplo de geração: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Chave da API do ImgBB para upload de imagens.
IMG_BB_KEY=

# Origens autorizadas para CORS (separadas por vírgula).
# Deixe em branco ou use "*" em desenvolvimento para permitir qualquer origem.
# Exemplo para produção: https://meufrontend.com,https://admin.meufrontend.com
CORS_ORIGIN=

# Ambiente de execução: development | production | test
NODE_ENV=development

# Porta do servidor (opcional, padrão: 3000)
# PORT=3000
